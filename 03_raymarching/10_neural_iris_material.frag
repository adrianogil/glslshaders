vec3 decodePigment(vec2 uv,float hue) {
  float angle=(uv.x-.5)*6.28318530718;
  float r=mix(.110,.226,uv.y);
  vec2 delta=r*vec2(cos(angle),sin(angle)),p=delta+vec2(0,.018);
  vec3 learned=neuralEye(p,0.0,vec4(.5,.5,0,0),hue);
  float iris=1.0/(1.0+exp(-52.0*(.245-r)));
  float pupil=1.0/(1.0+exp(-68.0*(.065-r)));
  float highlight=exp(-150.0*dot(delta+vec2(.075,-.075),delta+vec2(.075,-.075)));
  float lidArc=.418*sqrt(max(1.0-p.x*p.x/(.91*.91),0.0));
  float lidLine=exp(-150.0*pow(abs(p.y)-lidArc,2.0))/(1.0+exp(-18.0*(.98-abs(p.x))));
  float scleraShade=.76-.18*r+.08*p.x;
  vec3 unlit=(learned/(1.0-.42*lidLine)-highlight*vec3(.95,.98,1.0)-vec3(.008,.012,.018)*pupil)/(1.0-pupil);
  unlit=(unlit-scleraShade*vec3(1,.92,.89)*(1.0-iris))/iris;
  return clamp(unlit,.012,.90);
}

void mainImage(out vec4 fragColor,in vec2 fragCoord) {
  ivec2 pixel=ivec2(fragCoord);
  vec4 previous=texelFetch(iChannel0,ivec2(0,0),0);
  vec4 metadata=texelFetch(iChannel0,ivec2(1,0),0);
  bool fresh=iFrame==0||any(notEqual(metadata.zw,iResolution.xy));
  vec4 controls=fresh?vec4(23.0/57.0,.35,.56,17.0/44.0):previous;
  float manual=fresh?0.0:metadata.x;
  if(iMouse.z>0.0) {
    vec2 mouse=clamp(iMouse.xy/iResolution.xy,0.0,1.0);
    vec2 origin=abs(iMouse.zw)/iResolution.xy;
    if(origin.y>.22) {
      controls.x=mouse.x;
      controls.w=clamp((mouse.y-.22)/.78,0.0,1.0);
      manual=1.0;
    }else if(origin.x>.89) {
      controls.x=23.0/57.0;controls.w=17.0/44.0;manual=0.0;
    }else if(origin.y>.11) {
      controls.z=clamp((mouse.x-.15)/.70,0.0,1.0);
    }else{
      controls.y=clamp((mouse.x-.15)/.70,0.0,1.0);
    }
  }
  if(pixel.y==0) {
    fragColor=pixel.x==0?controls:(pixel.x==1?vec4(manual,0,iResolution.xy):vec4(0));
    return;
  }
  ivec2 size=min(ivec2(iResolution.xy)-ivec2(0,1),ivec2(512,256));
  if(pixel.x>=size.x||pixel.y>size.y){fragColor=vec4(0);return;}
  vec4 cached=texelFetch(iChannel0,pixel,0);
  if(!fresh&&abs(controls.z-previous.z)<1e-6&&cached.a>.5) {
    fragColor=cached;return;
  }
  vec2 uv=(vec2(pixel-ivec2(0,1))+.5)/vec2(size);
  fragColor=vec4(decodePigment(uv,controls.z),1);
}
